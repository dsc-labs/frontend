# Example configuration for strikerobot.ai.
# The landing-page process listens on 127.0.0.1:3000.

strikerobot.ai {
	# Keep the public strikerobot.ai URL while SR Platform runs on Eastworlds.
	# These response headers let Paddle load and open its checkout window.
	handle /sr-platform/app/* {
		header {
			-Cross-Origin-Embedder-Policy
			Cross-Origin-Opener-Policy "same-origin-allow-popups"
		}

		reverse_proxy https://eastworlds.strikerobot.ai {
			header_up Host eastworlds.strikerobot.ai
		}
	}

	# Serve the landing page and its Vite middleware routes.
	handle {
		reverse_proxy 127.0.0.1:3000
	}
}

# Validate and reload after copying this configuration to the server:
#   sudo caddy validate --config /etc/caddy/Caddyfile
#   sudo systemctl reload caddy
