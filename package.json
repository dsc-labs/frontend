{
  "name": "mma-robot-landing",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "waitlist:snapshot": "curl -sS \"http://localhost:3000/api/waitlist/snapshot\"",
    "epoch2:dump": "node scripts/dump-epoch2-leaderboard.cjs",
    "epoch2:sr-balances": "node scripts/query-epoch2-sr-balances.cjs",
