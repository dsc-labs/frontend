    "epoch2:check-sr": "tsx scripts/check-epoch2-sr-eligibility.mjs",
    "epoch2:trace-wallet": "tsx scripts/trace-wallet-snapshots.mjs",
    "epoch2:score-user": "tsx scripts/score-user-epochs.mjs",
