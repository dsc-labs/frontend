# Copy to .env and fill in. Restart `npm run dev` after changes.

# --- Privy (wallet connect; browser; safe to expose in bundle) ---
VITE_PRIVY_APP_ID=

# --- Privy (server only; used to verify auth tokens in /api/mindshare/submit) ---
# PRIVY_APP_ID is the same value as VITE_PRIVY_APP_ID — duplicated so it stays out of the bundle.
# PRIVY_APP_SECRET is from the Privy dashboard → Settings → API Keys.
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# --- X OAuth (browser; safe to expose in bundle) ---
VITE_X_OAUTH_CLIENT_ID=

# Optional: single fixed callback URL (must match X app settings exactly).
# If unset, redirects use origin + /leaderboard or /mindshare-challenge per page.
# VITE_X_OAUTH_REDIRECT_URI=

# Optional: external “Connect X” URL instead of built-in PKCE.
# VITE_X_CONNECT_URL=

# --- Base RPC ---
# Browser (Vite): read-only balance checks in the UI.
# VITE_BASE_RPC_URL=https://mainnet.base.org
#
# Server (waitlist /api/waitlist/*): same URL is fine — set one or both.
# Prefer this name for API routes; if unset, waitlist falls back to VITE_BASE_RPC_URL.
# BASE_RPC_URL=https://mainnet.base.org

# --- X OAuth (server only; Vite dev middleware + Vercel /api/x-oauth/exchange) ---
TWITTER_OAUTH2_CLIENT_ID=
TWITTER_OAUTH2_CLIENT_SECRET=

# --- Mindshare CSV append for /api/mindshare/submit ---
# Optional absolute/relative path for CSV output.
# Defaults to ./mindshare_submissions.csv
# MINDSHARE_SUBMISSIONS_CSV_PATH=./mindshare_submissions.csv

# --- Mindshare Epoch 2 leaderboard (/api/mindshare/test-epoch2-leaderboard) ---
# Same Bearer as avatar proxy; required for live X metrics (without it, CSV rows still load but scores stay 0).
# TWITTER_BEARER_TOKEN=
#
# Default human quality 0–7 used until per-post scores exist (see score.md). Must be > 3 for non-zero interaction from metrics.
# MINDSHARE_EPOCH2_DEFAULT_QUALITY=4
#
# Cache tweet + follower snapshots on disk (default ./data/mindshare/epoch2_metrics_cache.json).
# MINDSHARE_EPOCH2_METRICS_CACHE_PATH=
# MINDSHARE_EPOCH2_CACHE_TTL_MS=3600000
#
# Epoch 2 leaderboard SR gate: wallets must hold ≥ this many $SR on Base (human units).
# When BASE_RPC_URL or VITE_BASE_RPC_URL is set, balances are read on-chain for each mindshare wallet.
# Without RPC, only wallets present in waitlist `state.json` with `latestSrBalance` ≥ threshold count (often empty).
# MINDSHARE_EPOCH2_MIN_SR_TOKENS=10000
# Optional: parallel JSON-RPC limit for on-chain SR reads (default 8).
# MINDSHARE_EPOCH2_SR_GATE_RPC_CONCURRENCY=8
# Local only — disable SR gate (do not use in production):
# MINDSHARE_EPOCH2_SKIP_WAITLIST_SR_GATE=1
#
# Scheduled refresh (Vercel Cron): `vercel.json` calls GET /api/mindshare/epoch2-refresh every 30 minutes.
# Uses the same secrets as waitlist crons: set CRON_SECRET in the Vercel project (Bearer), or WAITLIST_CRON_SECRET.
# Local manual refresh without headers: MINDSHARE_EPOCH2_CRON_SKIP_AUTH=1 (never rely on this on production).
#
# Daily Epoch 2 SR eligibility snapshot (Vercel Cron `0 17 * * *` = 00:00 GMT+7): GET/POST `/api/mindshare/epoch2-sr-snapshot`
# — writes `data/mindshare/epoch2_sr_eligible_wallets.json` (live leaderboard uses this list only; scores stay live from X).
# — appends one jsonl audit line. Eligible = on-chain SR **>** 10_000 (hardcoded). After `EPOCH_2_END_MS` returns `{ skipped: true }`.
# `npm run dev` / `vite preview`: schedules the same HTTP call at each 17:00 UTC. Disable: MINDSHARE_EPOCH2_SR_SNAPSHOT_DEV_CRON=0
# If the eligible file is missing, leaderboard SR gate falls back to live on-chain reads (disable: MINDSHARE_EPOCH2_SR_GATE_LIVE_FALLBACK=0).
# MINDSHARE_EPOCH2_SR_ELIGIBLE_WALLETS_PATH=
# MINDSHARE_EPOCH2_SR_SNAPSHOT_LOG_PATH=
# MINDSHARE_EPOCH2_SR_SNAPSHOT_RPC_CONCURRENCY=8

# scripts/dump-epoch2-top2.cjs — optional cap (default: all wallets with ≥1 post). EPOCH2_DUMP_TOP_N=100 for top 100 only.
# EPOCH2_DUMP_TOP_N=0
# SR floor for rows (default: same as MINDSHARE_EPOCH2_MIN_SR_TOKENS). Set EPOCH2_DUMP_MIN_SR_TOKENS=0 to include 0 SR.
# EPOCH2_DUMP_MIN_SR_TOKENS=10000
# SR column: reads on-chain $SR on Base when BASE_RPC_URL or VITE_BASE_RPC_URL is set (default). Disable: EPOCH2_DUMP_FETCH_SR=0
# Prefer waitlist snapshot over chain: EPOCH2_DUMP_SR_PRIORITY=waitlist
# EPOCH2_DUMP_RPC_CONCURRENCY=8

# --- Waitlist snapshot calculator ---
# On-disk JSON (authoritative). Default: ./data/waitlist/state.json
# If that file is missing, ./waitlist_state.json is read once for migration.
# WAITLIST_STATE_PATH=/absolute/or/relative/waitlist_state.json
#
# Optional: after each JSON save, also rewrite CSV mirrors (users, snapshots, last prices).
# WAITLIST_CSV_MIRROR_DIR=./data/waitlist/csv
#
# Fallback USD prices per token unit for /api/waitlist/snapshot (after Dexscreener + last snapshot cache).
# SR_USD_PRICE=0.02
# VVV_USD_PRICE=0.02
#
# Optional: lock /api/waitlist/snapshot
# - Manual calls: header x-cron-secret: <same value>
# - Vercel Cron: set CRON_SECRET in the Vercel dashboard; cron sends Authorization: Bearer …
#   (If you only set WAITLIST_CRON_SECRET, scheduled runs get 401 unless you also send x-cron-secret.)
# WAITLIST_CRON_SECRET=
# CRON_SECRET=
#
# Local snapshot (no Vercel cron):
# - `npm run dev` / `vite preview` auto-call /api/waitlist/snapshot every 15 min (no .env needed).
# - Opt out: WAITLIST_DEV_CRON=0 or WAITLIST_DEV_CRON_DISABLED=1
# - Custom interval: WAITLIST_DEV_CRON_MS=60000
# - Manual: npm run waitlist:snapshot
# If WAITLIST_CRON_SECRET is set locally, also set (dev only):
# WAITLIST_SNAPSHOT_SKIP_AUTH=1
# (ignored on Vercel where VERCEL=1 — use CRON_SECRET / headers in production.)

