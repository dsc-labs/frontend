# Copy to .env and fill in. Restart `npm run dev` after changes.

# --- X OAuth (browser; safe to expose in bundle) ---
VITE_X_OAUTH_CLIENT_ID=

# Optional: single fixed callback URL (must match X app settings exactly).
# If unset, redirects use origin + /leaderboard or /mindshare-challenge per page.
# VITE_X_OAUTH_REDIRECT_URI=

# Optional: external “Connect X” URL instead of built-in PKCE.
# VITE_X_CONNECT_URL=

# --- X OAuth (server only; Vite dev middleware + Vercel /api/x-oauth/exchange) ---
TWITTER_OAUTH2_CLIENT_ID=
TWITTER_OAUTH2_CLIENT_SECRET=

# --- Google Sheets append for /api/mindshare/submit ---
# Service account email from your Google Cloud service account.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Private key from the service account JSON. Keep quotes and \n escapes in .env.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Optional: defaults to the provided Mindshare sheet id.
# GOOGLE_SHEETS_SPREADSHEET_ID=1SDrT1CvJlgp6Se-onIGzaiy5D-kSF_a_hnLd630DsJo
# Optional: defaults to Sheet1.
# GOOGLE_SHEETS_SHEET_NAME=Sheet1

