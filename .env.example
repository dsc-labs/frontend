# Copy to .env and fill in. Restart `npm run dev` after changes.

# --- Privy (wallet connect; browser; safe to expose in bundle) ---
VITE_PRIVY_APP_ID=

# --- Privy (server only; used to verify auth tokens in /api/mindshare/submit) ---
# PRIVY_APP_ID is the same value as VITE_PRIVY_APP_ID — duplicated so it stays out of the bundle.
# PRIVY_APP_SECRET is from the Privy dashboard → Settings → API Keys.
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# --- X OAuth (browser; safe to expose in bundle) ---
VITE_X_OAUTH_CLIENT_ID=

# Optional: single fixed callback URL (must match X app settings exactly).
# If unset, redirects use origin + /leaderboard or /mindshare-challenge per page.
# VITE_X_OAUTH_REDIRECT_URI=

# Optional: external “Connect X” URL instead of built-in PKCE.
# VITE_X_CONNECT_URL=

# --- Base RPC ---
# Browser (Vite): read-only balance checks in the UI.
# VITE_BASE_RPC_URL=https://mainnet.base.org
#
# Server (waitlist /api/waitlist/*): same URL is fine — set one or both.
# Prefer this name for API routes; if unset, waitlist falls back to VITE_BASE_RPC_URL.
# BASE_RPC_URL=https://mainnet.base.org

# --- X OAuth (server only; Vite dev middleware + Vercel /api/x-oauth/exchange) ---
TWITTER_OAUTH2_CLIENT_ID=
TWITTER_OAUTH2_CLIENT_SECRET=

# --- Mindshare CSV append for /api/mindshare/submit ---
# Epoch 2: snapshots hardcoded to ./data/newmindshare (see data/newmindshare/README.md).
# Live CSV defaults to ./mindshare_submissions.csv at repo root.
# MINDSHARE_SUBMISSIONS_CSV_PATH=./mindshare_submissions.csv

# --- Mindshare Epoch 2 leaderboard (/api/mindshare/test-epoch2-leaderboard) ---
# Same Bearer as avatar proxy; required for live X metrics (without it, CSV rows still load but scores stay 0).
# TWITTER_BEARER_TOKEN=
#
# Default quality 0–7 per post until rubric/reviewer scores exist (see score.md). Score = quality × follower multiplier.
# MINDSHARE_EPOCH2_DEFAULT_QUALITY=4
# Engagement stat cards: default uses lib/mindshareEpoch2Constants.ts EPOCH2_PUBLIC_ENGAGEMENT_STATS
# MINDSHARE_EPOCH2_USE_COMPUTED_ENGAGEMENT_STATS=1
#
# Cache tweet + follower snapshots on disk (default ./data/newmindshare/epoch2_metrics_cache.json).
# MINDSHARE_EPOCH2_METRICS_CACHE_PATH=
# TTL for treating cached tweet/user metrics as fresh (default 1h). Set ≥ your epoch2-refresh cadence so page loads do not hit X; cron uses force refresh.
# MINDSHARE_EPOCH2_CACHE_TTL_MS=3600000
#
# Epoch 2 leaderboard SR gate: wallets must hold ≥ this many $SR on Base (human units).
# When BASE_RPC_URL or VITE_BASE_RPC_URL is set, balances are read on-chain for each mindshare wallet.
# Without RPC, only wallets present in waitlist `state.json` with `latestSrBalance` ≥ threshold count (often empty).
# MINDSHARE_EPOCH2_MIN_SR_TOKENS=10000
# Optional: parallel JSON-RPC limit for on-chain SR reads (default 8).
# MINDSHARE_EPOCH2_SR_GATE_RPC_CONCURRENCY=8
# Local only — disable SR gate (do not use in production):
# MINDSHARE_EPOCH2_SKIP_WAITLIST_SR_GATE=1
#
# Checkpoint snapshots (Vercel Cron `0 5 15,16,17,18,20 5 *` UTC): GET /api/mindshare/epoch2-sr-snapshot
# — (1) SR eligibility at archive block for 05:00 UTC on tick day, then (2) post windows + scores → epoch2_leaderboard_snapshot.json
# BASE_ARCHIVE_RPC_URL — required for step 1 (falls back to BASE_RPC_URL; use an archive-capable Base endpoint)
# Optional dev alias to same job: MINDSHARE_EPOCH2_REFRESH_DEV_CRON=1 (off by default).
# MINDSHARE_EPOCH2_REFRESH_DEV_CRON_MS=900000
# MINDSHARE_EPOCH2_LEADERBOARD_SNAPSHOT_PATH=
# MINDSHARE_EPOCH2_DAILY_STATE_PATH=
# MINDSHARE_EPOCH2_DAILY_SNAPSHOT_LOG_PATH=
# Epoch 1 final export for carryover (ranks 102+ merge; ranks 1–101 excluded). Default: ./leaderboard_export.csv
# MINDSHARE_EPOCH1_LEADERBOARD_CSV_PATH=
# X profile images for Epoch 2 leaderboard (username,avatar). Default: ./submission-avatars.csv
# MINDSHARE_SUBMISSION_AVATARS_CSV_PATH=
# Uses the same secrets as waitlist crons: set CRON_SECRET in the Vercel project (Bearer), or WAITLIST_CRON_SECRET.
# Local manual refresh without headers: MINDSHARE_EPOCH2_CRON_SKIP_AUTH=1 (never rely on this on production).
#
# Daily Epoch 2 job (same cron): GET/POST `/api/mindshare/epoch2-sr-snapshot` — see snapshot.md for post day windows.
# Recount only (fix postCount/scores from countedPostKeys; no SR snapshot, no new window posts):
#   POST `/api/mindshare/epoch2-recount`  or  `npm run epoch2:recount`
#   EPOCH2_RECOUNT_API_URL=http://127.0.0.1:4022/api/mindshare/epoch2-recount
# Recount and posts-backfill run even after Epoch 2 ended (live `epoch2-sr-snapshot` cron still stops).
#
# Full rebuild in data/newmindshare (SR backfill all days + post replay + score):
#   npm run epoch2:rebuild
#   POST `/api/mindshare/epoch2-rebuild?latestSr=1`  optional `&dataDir=./data/newmindshare`
#
# Full post replay only (checkpoint days 15→18 & 20 → countedPostKeys + score; see snapshot.md):
#   POST `/api/mindshare/epoch2-posts-backfill?replace=1`  optional `&days=2026-05-15,2026-05-16`  `&runSr=1`
#   npm run epoch2:posts-backfill -- --replace
#   EPOCH2_POSTS_BACKFILL_API_URL=http://127.0.0.1:4022/api/mindshare/epoch2-posts-backfill?replace=1
#
# Historical SR checkpoint backfill (archive RPC, one eligibility day → epoch2_sr_snapshots.jsonl):
#   POST `/api/mindshare/epoch2-sr-backfill-day?day=2026-05-16`  optional `&replace=1`
#   npm run epoch2:sr-backfill-day -- --day 2026-05-16 --replace
#   BASE_ARCHIVE_RPC_URL=https://...  (Alchemy/QuickNode archive on Base; required for old blocks)
# Alchemy throughput: default concurrency 2, 200ms between wallets, 8s between SR days (raise tier or lower further if rate-limited)
# MINDSHARE_EPOCH2_SR_BACKFILL_RPC_CONCURRENCY=2
# MINDSHARE_EPOCH2_SR_RPC_DELAY_MS=300
# MINDSHARE_EPOCH2_SR_DAY_PAUSE_MS=10000
#
# Check one wallet/handle SR checkpoints by day (jsonl + optional on-chain):
#   npm run epoch2:check-sr -- denispodd_17
#   npm run epoch2:check-sr -- --wallet 0x... --chain
# Trace wallet across CSV, SR jsonl, leaderboard, daily state:
#   npm run epoch2:trace-wallet -- 0x...  or  npm run epoch2:trace-wallet -- handle
#   npm run epoch2:score-user -- denispodd_17   # Epoch 1 + Epoch 2 points by eligibility day
#   npm run epoch2:score-user -- denispodd_17 --chain   # SR from archive RPC, not jsonl
# Writes epoch2_sr_eligible_wallets.json, epoch2_leaderboard_snapshot.json, epoch2_daily_state.json. Eligible = on-chain SR **>** 10_000.
# `npm run dev` / `vite preview`: optional — same HTTP call at each 05:00 UTC checkpoint day if MINDSHARE_EPOCH2_SR_SNAPSHOT_DEV_CRON=1 (default: off; use /epoch2 or curl to snapshot manually).
# If the eligible file is missing, X API and scoring are skipped unless you opt in to temporary RPC eligibility:
# MINDSHARE_EPOCH2_SR_GATE_LIVE_FALLBACK=1
# MINDSHARE_EPOCH2_SR_ELIGIBLE_WALLETS_PATH=
# MINDSHARE_EPOCH2_SR_SNAPSHOT_LOG_PATH=
# MINDSHARE_EPOCH2_SR_SNAPSHOT_RPC_CONCURRENCY=8

# scripts/dump-epoch2-leaderboard.cjs — CSV of live /epoch2 (snapshot file or API). See script header.
#   node scripts/dump-epoch2-leaderboard.cjs > epoch2_leaderboard.csv
#   EPOCH2_DUMP_API_URL=http://127.0.0.1:3000/api/mindshare/test-epoch2-leaderboard
#   EPOCH2_DUMP_TOP_N=100  EPOCH2_DUMP_ELIGIBLE_ONLY=1
#
# scripts/dump-epoch2-top2.cjs — recompute from CSV only (not /epoch2 snapshot). walletAddress,xHandle,…
# EPOCH2_DUMP_TOP_N=0
# SR floor for rows (default: same as MINDSHARE_EPOCH2_MIN_SR_TOKENS). Set EPOCH2_DUMP_MIN_SR_TOKENS=0 to include 0 SR.
# EPOCH2_DUMP_MIN_SR_TOKENS=10000
# SR column: reads on-chain $SR on Base when BASE_RPC_URL or VITE_BASE_RPC_URL is set (default). Disable: EPOCH2_DUMP_FETCH_SR=0
# Prefer waitlist snapshot over chain: EPOCH2_DUMP_SR_PRIORITY=waitlist
# EPOCH2_DUMP_RPC_CONCURRENCY=8

# --- Waitlist snapshot calculator ---
# On-disk JSON (authoritative). Default: ./data/waitlist/state.json
# If that file is missing, ./waitlist_state.json is read once for migration.
# WAITLIST_STATE_PATH=/absolute/or/relative/waitlist_state.json
#
# Optional: after each JSON save, also rewrite CSV mirrors (users, snapshots, last prices).
# WAITLIST_CSV_MIRROR_DIR=./data/waitlist/csv
#
# Fallback USD prices per token unit for /api/waitlist/snapshot (after Dexscreener + last snapshot cache).
# SR_USD_PRICE=0.02
# VVV_USD_PRICE=0.02
#
# Optional: lock /api/waitlist/snapshot
# - Manual calls: header x-cron-secret: <same value>
# - Vercel Cron: set CRON_SECRET in the Vercel dashboard; cron sends Authorization: Bearer …
#   (If you only set WAITLIST_CRON_SECRET, scheduled runs get 401 unless you also send x-cron-secret.)
# WAITLIST_CRON_SECRET=
# CRON_SECRET=
#
# Local snapshot (no Vercel cron):
# - `npm run dev` / `vite preview` auto-call /api/waitlist/snapshot every 15 min (no .env needed).
# - Opt out: WAITLIST_DEV_CRON=0 or WAITLIST_DEV_CRON_DISABLED=1
# - Custom interval: WAITLIST_DEV_CRON_MS=60000
# - Manual: npm run waitlist:snapshot
# If WAITLIST_CRON_SECRET is set locally, also set (dev only):
# WAITLIST_SNAPSHOT_SKIP_AUTH=1
# (ignored on Vercel where VERCEL=1 — use CRON_SECRET / headers in production.)

