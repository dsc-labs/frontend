# Copy to .env and fill in. Restart `npm run dev` after changes.

# --- Privy (wallet connect; browser; safe to expose in bundle) ---
VITE_PRIVY_APP_ID=

# --- Privy (server only; used to verify auth tokens in /api/mindshare/submit) ---
# PRIVY_APP_ID is the same value as VITE_PRIVY_APP_ID — duplicated so it stays out of the bundle.
# PRIVY_APP_SECRET is from the Privy dashboard → Settings → API Keys.
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# --- X OAuth (browser; safe to expose in bundle) ---
VITE_X_OAUTH_CLIENT_ID=

# Optional: single fixed callback URL (must match X app settings exactly).
# If unset, redirects use origin + /leaderboard or /mindshare-challenge per page.
# VITE_X_OAUTH_REDIRECT_URI=

# Optional: external “Connect X” URL instead of built-in PKCE.
# VITE_X_CONNECT_URL=

# --- Base RPC ---
# Browser (Vite): read-only balance checks in the UI.
# VITE_BASE_RPC_URL=https://mainnet.base.org
#
# Server (waitlist /api/waitlist/*): same URL is fine — set one or both.
# Prefer this name for API routes; if unset, waitlist falls back to VITE_BASE_RPC_URL.
# BASE_RPC_URL=https://mainnet.base.org

# --- X OAuth (server only; Vite dev middleware + Vercel /api/x-oauth/exchange) ---
TWITTER_OAUTH2_CLIENT_ID=
TWITTER_OAUTH2_CLIENT_SECRET=

# --- Mindshare CSV append for /api/mindshare/submit ---
# Optional absolute/relative path for CSV output.
# Defaults to ./mindshare_submissions.csv
# MINDSHARE_SUBMISSIONS_CSV_PATH=./mindshare_submissions.csv

# --- Waitlist snapshot calculator ---
# On-disk JSON (authoritative). Default: ./data/waitlist/state.json
# If that file is missing, ./waitlist_state.json is read once for migration.
# WAITLIST_STATE_PATH=/absolute/or/relative/waitlist_state.json
#
# Optional: after each JSON save, also rewrite CSV mirrors (users, snapshots, last prices).
# WAITLIST_CSV_MIRROR_DIR=./data/waitlist/csv
#
# Fallback USD prices per token unit for /api/waitlist/snapshot (after Dexscreener + last snapshot cache).
# SR_USD_PRICE=0.02
# VVV_USD_PRICE=0.02
#
# Optional: lock /api/waitlist/snapshot
# - Manual calls: header x-cron-secret: <same value>
# - Vercel Cron: set CRON_SECRET in the Vercel dashboard; cron sends Authorization: Bearer …
#   (If you only set WAITLIST_CRON_SECRET, scheduled runs get 401 unless you also send x-cron-secret.)
# WAITLIST_CRON_SECRET=
# CRON_SECRET=
#
# Local snapshot (no Vercel cron):
# - `npm run dev` / `vite preview` auto-call /api/waitlist/snapshot every 15 min (no .env needed).
# - Opt out: WAITLIST_DEV_CRON=0 or WAITLIST_DEV_CRON_DISABLED=1
# - Custom interval: WAITLIST_DEV_CRON_MS=60000
# - Manual: npm run waitlist:snapshot
# If WAITLIST_CRON_SECRET is set locally, also set (dev only):
# WAITLIST_SNAPSHOT_SKIP_AUTH=1
# (ignored on Vercel where VERCEL=1 — use CRON_SECRET / headers in production.)

